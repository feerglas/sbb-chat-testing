{
  "name": "sbb-chat-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright automation for SBB chatbot regression testing",
  "scripts": {
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:case": "tsx scripts/run-test-case.ts",
    "test:headed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "report": "tsx scripts/generate-report.ts",
    "test:full": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test && npm run report",
    "report:md": "tsx scripts/generate-report.ts --format md",
    "report:html": "tsx scripts/generate-report.ts --format html"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
